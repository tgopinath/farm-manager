{
  "expo": {
    "name": "Farm Manager",
    "slug": "farm-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gopinath.farmmanager",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F0E3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gopinath.farmmanager"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Farm Manager",
      "themeColor": "#2F6B3A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Farm Manager uses the camera to photograph animals for health checks.",
          "photosPermission": "Farm Manager uses your photos for animal health checks."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6B3A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "scheme": "farmmanager"
  }
}
